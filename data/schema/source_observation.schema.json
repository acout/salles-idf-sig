{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salles-idf.local/schema/source_observation.schema.json",
  "title": "SourceObservation",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "run_id",
    "provider",
    "discovered_at",
    "source_url"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "observation_id": {"type": "string", "pattern": "^obs_"},
    "run_id": {"type": "string"},
    "provider": {"type": "string"},
    "provider_query_id": {"type": "string"},
    "provider_query_text": {"type": "string"},
    "provider_rank": {"type": ["integer", "number", "string", "null"]},
    "provider_score": {"type": ["integer", "number", "string", "null"]},
    "discovered_at": {"type": "string"},
    "source_url": {"type": "string"},
    "source_domain": {"type": "string"},
    "source_title": {"type": "string"},
    "source_snippet": {"type": "string"},
    "website_url": {"type": "string"},
    "specific_rental_page_url": {"type": "string"},
    "candidate_name_hint": {"type": "string"},
    "candidate_address_hint": {"type": "string"},
    "candidate_city_hint": {"type": "string"},
    "candidate_department_hint": {"type": "string"},
    "candidate_lat_hint": {"type": ["number", "string", "null"]},
    "candidate_lon_hint": {"type": ["number", "string", "null"]},
    "place_id": {"type": "string"},
    "osm_id": {"type": "string"},
    "maps_url": {"type": "string"},
    "raw_payload_path": {"type": "string"},
    "raw_payload_sha256": {"type": "string"},
    "content_path": {"type": "string"},
    "content_sha256": {"type": "string"},
    "legacy_source_record_id": {"type": "string"},
    "provider_extra": {"type": "object"}
  },
  "additionalProperties": true
}
