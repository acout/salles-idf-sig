{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salles-idf.local/schema/field_evidence.schema.json",
  "title": "FieldEvidence",
  "type": "object",
  "required": [
    "schema_version",
    "field_evidence_id",
    "observation_id",
    "field_name",
    "value_raw",
    "evidence_url",
    "extraction_method",
    "confidence",
    "extracted_at"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "field_evidence_id": {"type": "string", "pattern": "^fe_"},
    "venue_entity_id": {"type": "string"},
    "observation_id": {"type": "string"},
    "content_id": {"type": "string"},
    "field_name": {
      "type": "string",
      "enum": ["address", "contact", "price", "capacity", "rental_possible", "surface", "website", "specific_rental_page"]
    },
    "value_raw": {"type": "string"},
    "value_structured": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "evidence_quote": {"type": "string"},
    "evidence_url": {"type": "string"},
    "source_type": {"type": "string"},
    "extraction_method": {"type": "string"},
    "confidence": {"type": ["number", "string"]},
    "extracted_at": {"type": "string"}
  },
  "additionalProperties": true
}
