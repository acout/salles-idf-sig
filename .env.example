# Public browser configuration (safe as GitHub environment variables)
APP_MODE=shared
APP_RELEASE=local
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
SUPABASE_PRIVATE_BUCKET=venue-datasets

# Local/admin only. Never commit or paste this value in a ticket or chat.
SUPABASE_SERVICE_ROLE_KEY=replace-locally
